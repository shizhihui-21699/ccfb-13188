# --- 服务端口 ---
KMS_PORT=3100
APP_PORT=3200

# --- 管理端 / 服务间 Bearer 令牌（生产环境替换为 mTLS + 真实身份体系）---
SHRED_ADMIN_TOKEN=dev-admin-token-change-me
KMS_TOKEN=dev-admin-token-change-me

# --- KMS 密钥托管 ---
# 数据目录（密钥库、业务库、备份、凭证报告均落在此目录）
SHRED_DATA_DIR=./data
# Master Key 文件路径（生产环境应指向 KMS/HSM 托管，或挂载的加密卷）
SHRED_MASTER_KEY_FILE=./data/kms/master.key
# 也可改用环境变量直接注入（容器场景），base64 编码的 32 字节：SHRED_MASTER_KEY_B64=
SHRED_KEYSTORE_FILE=./data/kms/keystore.db
SHRED_SIGNING_KEY_FILE=./data/kms/signing.key

# --- 业务服务 ---
SHRED_APP_DB=./data/app/app.db
SHRED_APP_AUDIT_LOG=./data/app/audit.log
KMS_BASE_URL=http://127.0.0.1:3100

# --- 迁移 / 演示数据 ---
SHRED_LEGACY_DB=./data/legacy/legacy.db
SHRED_BACKUP_DIR=./data/backups
SHRED_VERIFY_DIR=./data/verifications

# DEK 明文在业务服务内存中的缓存 TTL（秒），注销时主动 purge
SHRED_DEK_CACHE_TTL_SECONDS=60
